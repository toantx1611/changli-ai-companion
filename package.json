{
  "name": "changli-ai-companion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:frontend\" \"npm:desktop\"",
    "frontend": "vite --host 127.0.0.1",
    "desktop": "wait-on http://127.0.0.1:5173 && electron .",
    "build": "vite build",
    "start": "electron ."
  },
  "main": "electron/main.cjs",
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "devDependencies": {
    "electron": "^45.5.0"
  }
}
